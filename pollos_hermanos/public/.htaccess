<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let the backend receive API requests.
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Serve existing files normally and route React paths to the SPA entry point.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
